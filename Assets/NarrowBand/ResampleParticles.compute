
#pragma use_dxc
#include "NBFlipUtils.hlsl"

#pragma target 6.0
// #pragma enable_d3d12_debug_symbols

#pragma kernel SetGridType
#pragma kernel SetGridLevel
#pragma kernel ParticlesCounter
#pragma kernel ResampleParticles
#pragma kernel ClearCounter
#pragma kernel ClearScanFlags

StructuredBuffer<int> _ParticlesIDR;
RWStructuredBuffer<int> _ParticlesIDW;

StructuredBuffer<uint> _ParticlesHashR;
RWStructuredBuffer<uint> _ParticlesHashW;

StructuredBuffer<Particle> _ParticlesR;
RWStructuredBuffer<Particle> _ParticlesW;

StructuredBuffer<uint2> _ParticlesRangeR;
RWStructuredBuffer<uint2> _ParticlesRangeW;

RWTexture3D<float> _GridSDFW;
Texture3D<float> _GridSDFR;

Texture3D<uint> _GridTypesR;
RWTexture3D<uint> _GridTypesW;

RWStructuredBuffer<uint> _CounterW;

Texture3D<float4> _VelocityR;

RWTexture3D<float4> _GridCoefficientW;

inline uint GetType(int3 coord)
{
    if (any(coord < 0) || any(coord >= _GridSize))
        return SOLID;
    if (_GridSDFR[coord] >= Band1) return FLUID;
    int2 range = _ParticlesRangeR[Coord2Idx(coord)];
    return range.y > range.x ? FLUID : AIR;
}

[numthreads(GROUP_THREADS_D3)]
void SetGridType (uint3 id : SV_DispatchThreadID)
{
    const uint gridType = GetType(id);
    const uint xp_type = GetType(id + int3(-1, 0, 0));
    const uint xn_type = GetType(id + int3(1, 0, 0));
    const uint yp_type = GetType(id + int3(0, -1, 0));
    const uint yn_type = GetType(id + int3(0, 1, 0));
    const uint zp_type = GetType(id + int3(0, 0, -1));
    const uint zn_type = GetType(id + int3(0, 0, 1));

    float center = 6 - (xp_type >> 1) - (xn_type >> 1) - (yp_type >> 1) - (yn_type >> 1) - (zp_type >> 1) -(zn_type >> 1);
    _GridCoefficientW[id] = gridType == FLUID ? float4(-center, xp_type & 1, yp_type & 1, zp_type & 1) : 0;
    _GridTypesW[id] = PackGridTyped(gridType, xp_type, xn_type, yp_type, yn_type, zp_type, zn_type);
}

[numthreads(GROUP_THREADS_D3)]
void SetGridLevel (uint3 id : SV_DispatchThreadID)
{
    uint gridType = _GridTypesR[id];
    float fill = -1;
    if (IsFluidCell(GetMyType(gridType)))
    {
        uint3 prevTypes = GetPrevTypes(gridType);
        uint3 nextTypes = GetNextTypes(gridType);
        fill = any(prevTypes == AIR) || any(nextTypes == AIR) ? 0 : 32;
    }

    _GridSDFW[id] = fill;
}

globallycoherent RWStructuredBuffer<uint> _PartitionScanDescriptors; // init with 0

#define PARTITION_SIZE      512
#define FLAG_INVALID        0u
#define FLAG_AGGREGATE      1u
#define FLAG_PREFIX         2u

groupshared uint sharedData[16];
groupshared uint partitionIndex;
groupshared uint sharedPrefix;

// Slot layout (SweepCommon.hlsl style — each partition publishes to pid+1,
// look-back reads from pid; this offset prevents races between publish and
// predecessor's prefix update, because slot[pid+1]'s first writer is always partition pid):
//   slot[0]                  = seed  FLAG_PREFIX | 0 (set by ClearScanFlags)
//   slot[1 .. _NumPartitions] = per-partition data
//   slot[_NumPartitions + 1]  = partition-index counter (InterlockedAdd)
[numthreads(PARTITION_SIZE, 1, 1)]
void ParticlesCounter (uint id : SV_GroupIndex)
{
    if (id < 16)
    {
        sharedData[id] = 0;
    }
    // Assign Partition by atomic add on dedicated counter slot
    if (id == 0)
    {
        InterlockedAdd(_PartitionScanDescriptors[_NumPartitions + 1], 1u, partitionIndex);
        sharedPrefix = 0;
    }
    int wid = id / 32;
    GroupMemoryBarrierWithGroupSync();
    uint pid = partitionIndex;
    uint globalIdx = pid * PARTITION_SIZE + id;

    int level = _GridSDFR[MortonD3Decode(globalIdx)];

    uint2 range = _ParticlesRangeR[globalIdx];
    uint count = 0;
    uint expect = 0;
    if (level >= 0 && level < Band2)
    {
        count = clamp(range.y - range.x, 0, 32);
        expect = level < 1 ? count : max(8, count);
    }

    uint val = expect;
    uint localInclusive = WavePrefixSum(val) + val;

    if (WaveGetLaneIndex() == 31) sharedData[wid] = localInclusive;
    GroupMemoryBarrierWithGroupSync();

    if (id < 16)
    {
        sharedData[id] += WavePrefixSum(sharedData[id]);
    }

    GroupMemoryBarrierWithGroupSync();

    uint aggregate = sharedData[15];

    // Publish aggregate to slot[pid+1]
    // (no special case for pid==0 — slot[0] is the seed, never written here)
    if (id == 0)
    {
        InterlockedAdd(_PartitionScanDescriptors[pid + 1], (FLAG_AGGREGATE | (aggregate << 2)));
    }

    // === Look-back: start from slot[pid] (holds partition pid-1's data) ===
    if (id == 0)
    {
        int lookback = pid;
        uint lookbackReduction = 0;
        while (lookback >= 0)
        {
            const uint desc = _PartitionScanDescriptors[lookback];
            if ((desc & 3) == FLAG_PREFIX) {
                // found inclusive prefix for partitions 0..lookback
                lookbackReduction += desc >> 2;
                // forward the prefix to the next partition's slot
                if (pid < _NumPartitions - 1)
                    InterlockedAdd(_PartitionScanDescriptors[pid + 1], FLAG_AGGREGATE | (lookbackReduction << 2));

                sharedPrefix = lookbackReduction;
                break;
            }

            if ((desc & 3) == FLAG_AGGREGATE)
            {
                lookbackReduction += desc >> 2;
                lookback--;
                continue;
            }
            // FLAG_INVALID (0): partition hasn't published yet — spin.
        }
    }
    
    GroupMemoryBarrierWithGroupSync();
    
    // === global scan result ===
    int offset = sharedPrefix + localInclusive - val + (wid > 0 ? sharedData[wid - 1] : 0);
    
    // total count
    if (pid == _NumPartitions - 1 && id == 0) {
        _CounterW[0] = min(sharedPrefix + aggregate, _NumParticles);
    }
    
    if (globalIdx < _NumCells)
    {
        uint oldPtr = range.x;
        for (int j = 0; j < expect; j++)
        {
            _ParticlesIDW[offset + j] = j < count ? oldPtr + j : -1; // if need add particle, set -1
        }
        _ParticlesRangeW[globalIdx] = min(uint2(offset, offset + expect), _NumParticles - 1);
    }
}

[numthreads(GROUP_THREADS_D3)]
void ResampleParticles (uint3 id : SV_DispatchThreadID)
{
    uint2 range = _ParticlesRangeR[Coord2Idx(id)];
    if (range.x >= range.y) return;
    int toAdd = 0;
    for (uint i = range.x; i < range.y; i++)
    {
        int pid = _ParticlesIDR[i];
        if (pid == -1)
            toAdd++;
        else
        {
            _ParticlesW[i] = _ParticlesR[pid];
        }
    }
    
    if (toAdd == 0) return;
    
    int existCount = range.y - range.x - toAdd;
    Particle posArr[8];
    [unroll]
    for (int i = 0; i < 8; i++)
    {
        if (i < existCount)
        {
            int p = _ParticlesIDR[range.x + i];
            posArr[i] = _ParticlesR[p];
        }
        else
        {
            posArr[i] = (Particle)0;
        }
    }
    
    int3 coord = id;
    float3 origin = ((float3)coord + 0.25f) * _CellSize;
    for (int idx = 0; idx < toAdd; idx++)
    {
        float maxDst = 0;
        float3 selectedPos = origin;
        [unroll]
        for (int i = 0; i < 8; i++)
        { 
            float3 tryPos = origin + float3(i & 1, i >> 1 & 1, i >> 2 & 1) * (_CellSize * 0.5f);
            float minDst = 1000;
            for (int j = 0; j < existCount; j++)
            {
                float3 vec = DecodePosition(posArr[j].packedPosition) - tryPos;
                float len = dot(vec, vec);
                minDst = min(minDst, len);
            }

            if (minDst > maxDst)
            {
                maxDst = minDst;
                selectedPos = tryPos;
            }
        }
        float3 v = SampleGrid(selectedPos, _VelocityR);
        int p = range.x + existCount;
        Particle pa;
        pa.packedPosition = EncodePosition(selectedPos);
        pa.packedVelocity = EncodeVelocity(v);
        _ParticlesW[p] = pa;
        posArr[existCount] = pa;
        existCount++;
    }
}

[numthreads(64, 1, 1)]
void ClearCounter (uint3 id : SV_DispatchThreadID)
{
    if (id.x < 2) _CounterW[id.x] = 0;
}

[numthreads(GROUP_THREADS_X, 1, 1)]
void ClearScanFlags (uint3 id : SV_DispatchThreadID)
{
    // Clear all slots (0 .. _NumPartitions + 1), then set slot[0] as seed
    if (id.x <= _NumPartitions + 1)
        _PartitionScanDescriptors[id.x] = 0;
    if (id.x == 0)
        _PartitionScanDescriptors[0] = FLAG_PREFIX; // seed with inclusive sum = 0
}